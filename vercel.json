{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://localhost:5000/:path*"
    },
    {
      "source": "/(about|contact|privacy-policy|terms|help)",
      "destination": "/index.html"
    },
    {
      "source": "/:shortId([A-Za-z0-9_-]{3,32})",
      "destination": "http://localhost:5000/:shortId"
    }
  ]
}
